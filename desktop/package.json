{
  "name": "waystone-desktop",
  "version": "0.4.1",
  "private": true,
  "description": "A place for friends to talk, draw and build together",
  "author": "Waystone",
  "main": "main.cjs",
  "scripts": {
    "build": "esbuild src/app.js --bundle --format=esm --outfile=dist/app.js",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test test/*.test.mjs",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win nsis",
    "package:mac": "npm run build && electron-builder --mac dmg",
    "test:e2e": "npm run build && node e2e/smoke.mjs",
    "package:mac:zip": "npm run build && electron-builder --mac zip"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "phoenix": "^1.8.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "ws": "^8.22.1"
  },
  "build": {
    "appId": "dev.waystone.desktop",
    "productName": "Waystone",
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "src/style.css",
      "dist/**",
      "policy.cjs",
      "canvas-store.cjs",
      "src/canvas-model.cjs",
      "src/board-model.cjs",
      "board-files.cjs"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.social-networking"
    },
    "directories": {
      "output": "release"
    }
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
